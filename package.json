{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "compass-harness",
  "description": "A terminal AI coding agent harness",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compass": "bun run --cwd packages/cli src/index.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "oxlint",
    "format": "prettier --ignore-unknown --write ."
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.3.14",
    "oxlint": "1.78.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
